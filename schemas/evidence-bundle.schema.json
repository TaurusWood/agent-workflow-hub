{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TaurusWood/agent-workflow-hub/main/schemas/evidence-bundle.schema.json",
  "title": "EvidenceBundle (DRAFT)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "observation_id",
    "collected_at",
    "capture_mode",
    "redaction",
    "actions",
    "network",
    "console_errors",
    "screenshots",
    "capture_gaps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "capture_mode": {
      "enum": [
        "short_recording",
        "manual_import"
      ]
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed",
        "policy_version"
      ],
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "policy_version": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "time",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string"
          }
        }
      }
    },
    "network": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "time",
          "method",
          "url_redacted"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "method": {
            "type": "string"
          },
          "url_redacted": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    },
    "console_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "time",
          "message_redacted"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "message_redacted": {
            "type": "string"
          },
          "source_location": {
            "type": "string"
          }
        }
      }
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "time",
          "artifact_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "artifact_ref": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "capture_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
